.tabbar-shell {
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  height: calc(70px + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1px solid #e3ebf6;
  box-shadow: 0 -4px 16px rgba(15, 23, 42, .05);
}

.tabbar-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70px;
  color: #94a3b8;
}

.tabbar-item:active {
  opacity: .68;
}

.tabbar-icon {
  position: relative;
  width: 24px;
  height: 24px;
  margin-bottom: 5px;
  color: currentColor;
}

.icon-home::before {
  content: '';
  position: absolute;
  left: 2px;
  top: 6px;
  width: 20px;
  height: 16px;
  border-radius: 3px;
  background: currentColor;
}

.icon-home::after {
  content: '';
  position: absolute;
  left: 3px;
  top: 1px;
  width: 18px;
  height: 18px;
  border-radius: 4px 4px 2px 2px;
  background: currentColor;
  transform: rotate(45deg) scale(.72);
}

.icon-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 4px;
}

.icon-grid::before,
.icon-grid::after,
.icon-grid .icon-core::before,
.icon-grid .icon-core::after {
  content: '';
  display: block;
  width: 10px;
  height: 10px;
  border-radius: 3px;
  background: currentColor;
}

.icon-grid .icon-core {
  display: contents;
}

.icon-user::before {
  content: '';
  position: absolute;
  left: 7px;
  top: 1px;
  width: 8px;
  height: 8px;
  border: 3px solid currentColor;
  border-radius: 50%;
}

.icon-user::after {
  content: '';
  position: absolute;
  left: 2px;
  bottom: 1px;
  width: 20px;
  height: 11px;
  border: 3px solid currentColor;
  border-radius: 12px 12px 4px 4px;
}

.tabbar-label {
  font-size: 14px;
  line-height: 1.2;
  white-space: nowrap;
  font-weight: 600;
}

.tabbar-item.selected {
  color: #1e40af;
}
