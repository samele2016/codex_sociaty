<view class="tabbar-shell">
  <view wx:for="{{items}}" wx:key="pagePath" class="tabbar-item {{selected === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="switchTab">
    <view class="tabbar-icon icon-{{item.icon}}"><view class="icon-core"></view></view>
    <text class="tabbar-label">{{item.label}}</text>
  </view>
</view>
