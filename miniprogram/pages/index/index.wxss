.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.post-button {
  background: #276749;
  color: #ffffff;
}

.search-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 22rpx;
  background: #ffffff;
  border: 1rpx solid #e5e8df;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.search-button {
  width: 128rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  background: #eef4e9;
  color: #276749;
}

.category-scroll {
  white-space: nowrap;
  margin-bottom: 18rpx;
}

.category-list {
  display: flex;
  gap: 12rpx;
}

.category {
  padding: 14rpx 22rpx;
  background: #ffffff;
  border: 1rpx solid #e5e8df;
  border-radius: 999rpx;
  color: #5f665c;
  font-size: 26rpx;
}

.category.active,
.sort.active {
  background: #276749;
  color: #ffffff;
  border-color: #276749;
}

.sort-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.sort {
  padding: 10rpx 20rpx;
  border: 1rpx solid #d9dfd2;
  border-radius: 999rpx;
  color: #667061;
  font-size: 24rpx;
}

.post-card {
  padding: 24rpx;
  margin-bottom: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e5e8df;
  border-radius: 12rpx;
}

.post-head {
  display: flex;
  gap: 10rpx;
  align-items: center;
  margin-bottom: 14rpx;
}

.pin,
.feature {
  font-size: 22rpx;
  color: #a15c00;
}

.post-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.post-content {
  color: #4b5548;
  font-size: 28rpx;
  line-height: 1.55;
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-top: 16rpx;
}

.image-grid image {
  width: 100%;
  height: 150rpx;
  border-radius: 8rpx;
  background: #f0f2ed;
}

.post-meta {
  display: flex;
  gap: 22rpx;
  margin-top: 16rpx;
  color: #7a8176;
  font-size: 24rpx;
}
