.home-page { width: 100%; min-height: 100vh; max-width: 1120px; margin: 0 auto; padding-bottom: calc(84px + env(safe-area-inset-bottom)); background: #f5f7fa; color: #172033; }
.home-nav { display: flex; align-items: center; gap: 12px; min-height: 60px; padding-left: 20px; padding-right: 20px; background: #fff; }
.brand-mark { display: flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 8px; background: #1d4ed8; color: #fff; font-size: 20px; font-weight: 800; }
.brand-copy { min-width: 0; } .brand-title { font-size: 18px; line-height: 1.25; font-weight: 800; } .brand-subtitle { margin-top: 2px; color: #667085; font-size: 12px; }
.hero-swiper { height: 228px; background: #fff; } .flag-slide { position: relative; height: 100%; overflow: hidden; background: #d9251d; color: #fff; }
.flag-slide::after { content: ''; position: absolute; right: -54px; bottom: -92px; width: 230px; height: 230px; border: 28px solid rgba(255,255,255,.09); border-radius: 50%; }
.flag-star { position: absolute; z-index: 1; background: #ffde33; clip-path: polygon(50% 0,61% 35%,98% 35%,68% 56%,79% 91%,50% 70%,21% 91%,32% 56%,2% 35%,39% 35%); }
.big-star { left: 28px; top: 24px; width: 52px; height: 52px; } .small-star { width: 20px; height: 20px; } .star-one { left: 90px; top: 20px; transform: rotate(22deg); } .star-two { left: 108px; top: 43px; transform: rotate(42deg); } .star-three { left: 106px; top: 72px; transform: rotate(4deg); } .star-four { left: 84px; top: 91px; transform: rotate(28deg); }
.hero-copy { position: absolute; z-index: 2; left: 24px; right: 24px; bottom: 24px; } .hero-kicker { margin-bottom: 7px; font-size: 13px; font-weight: 700; opacity: .9; } .hero-title { font-size: 25px; line-height: 1.25; font-weight: 800; } .hero-subtitle { margin-top: 8px; font-size: 15px; opacity: .94; }
.delivery-summary { display: flex; align-items: center; gap: 16px; margin: 16px; padding: 16px; min-height: 86px; border: 1px solid #e4e9f0; border-radius: 8px; background: #fff; }
.summary-date { display: flex; flex-direction: column; gap: 3px; color: #667085; font-size: 12px; } .summary-month { color: #1d4ed8; font-size: 18px; font-weight: 800; } .summary-divider { align-self: stretch; width: 1px; background: #e4e9f0; } .summary-main { flex: 1; min-width: 0; } .summary-label { color: #667085; font-size: 12px; } .summary-title { margin-top: 5px; overflow: hidden; color: #172033; font-size: 15px; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; } .summary-arrow, .notice-arrow { color: #98a2b3; font-size: 28px; line-height: 1; }
.home-section { margin-top: 12px; padding: 20px 16px; background: #fff; } .section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; } .section-title { font-size: 19px; font-weight: 800; } .section-caption { margin-top: 3px; color: #667085; font-size: 13px; }
.app-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 22px 8px; } .app-item { display: flex; flex-direction: column; align-items: center; justify-content: flex-start; min-height: 82px; } .app-symbol { display: flex; align-items: center; justify-content: center; width: 48px; height: 48px; margin-bottom: 9px; border-radius: 12px; font-size: 20px; font-weight: 800; } .symbol-blue { background: #e8f0ff; color: #1d4ed8; } .symbol-cyan { background: #e5f7f8; color: #087e8b; } .symbol-green { background: #e9f7ef; color: #15803d; } .symbol-orange { background: #fff1e8; color: #c2410c; } .symbol-violet { background: #f2edff; color: #6d28d9; } .symbol-red { background: #fff0f0; color: #b42318; } .symbol-gold { background: #fff6d8; color: #9a6700; } .symbol-gray { background: #eef1f5; color: #475467; } .app-label { max-width: 88px; color: #263247; font-size: 14px; line-height: 1.35; text-align: center; }
.notice-card { display: flex; align-items: center; gap: 10px; min-height: 58px; margin: 12px 16px; padding: 10px 14px; border: 1px solid #e4e9f0; border-radius: 8px; background: #fff; } .notice-badge { flex: 0 0 auto; padding: 4px 7px; border-radius: 4px; background: #eef4ff; color: #1d4ed8; font-size: 12px; font-weight: 700; } .notice-text { flex: 1; min-width: 0; overflow: hidden; color: #475467; font-size: 14px; white-space: nowrap; text-overflow: ellipsis; }
.recommendation-section { margin-bottom: 12px; } .ad-swiper { width: 100%; height: 188px; } .ad-banner { position: relative; height: 100%; padding: 22px; overflow: hidden; border-radius: 8px; color: #fff; } .ad-service { background: #1d4ed8; } .ad-community { background: #177245; } .ad-business { background: #9a4d12; } .ad-label { display: inline-block; padding: 4px 7px; border: 1px solid rgba(255,255,255,.56); border-radius: 4px; font-size: 12px; } .ad-title { margin-top: 18px; padding-right: 44px; font-size: 22px; line-height: 1.25; font-weight: 800; } .ad-desc { margin-top: 7px; max-width: 82%; font-size: 14px; line-height: 1.5; opacity: .92; } .ad-action { position: absolute; left: 22px; bottom: 18px; font-size: 13px; font-weight: 700; } .tap-muted { opacity: .72; }
@media (min-width: 720px) { .home-nav { padding-left: 32px; padding-right: 32px; } .hero-swiper { height: 290px; } .delivery-summary { margin-left: 32px; margin-right: 32px; } .home-section { padding-left: 32px; padding-right: 32px; } .app-grid { grid-template-columns: repeat(8,minmax(0,1fr)); } .notice-card { margin-left: 32px; margin-right: 32px; } .ad-swiper { height: 230px; } }
