<view class="home-page">
  <view class="home-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="brand-mark">阅</view>
    <view class="brand-copy"><view class="brand-title">{{communityName}}</view><view class="brand-subtitle">交付与装修服务平台</view></view>
  </view>
  <swiper class="hero-swiper" circular indicator-dots indicator-color="rgba(255,255,255,.45)" indicator-active-color="#ffffff">
    <swiper-item><view class="flag-slide">
      <view class="flag-star big-star"></view><view class="flag-star small-star star-one"></view><view class="flag-star small-star star-two"></view><view class="flag-star small-star star-three"></view><view class="flag-star small-star star-four"></view>
      <view class="hero-copy"><view class="hero-kicker">阅仕府业主服务</view><view class="hero-title">一起准备新家的第一步</view><view class="hero-subtitle">计划交付 {{deliveryMonth}}</view></view>
    </view></swiper-item>
  </swiper>
  <view class="delivery-summary" bindtap="openDelivery" hover-class="tap-muted" aria-label="查看交付中心">
    <view class="summary-date"><text class="summary-month">2027.04</text><text>计划交付</text></view><view class="summary-divider"></view>
    <view class="summary-main"><view class="summary-label">最新工程信息</view><view class="summary-title">{{latestUpdate ? latestUpdate.title : '交付资料正在持续整理'}}</view></view><view class="summary-arrow">›</view>
  </view>
  <view class="home-section">
    <view class="section-heading"><view><view class="section-title">常用服务</view><view class="section-caption">收房和装修的重要入口</view></view></view>
    <view class="app-grid"><view wx:for="{{apps}}" wx:key="key" class="app-item" data-item="{{item}}" bindtap="onAppTap" hover-class="tap-muted" aria-label="{{item.label}}"><view class="app-symbol symbol-{{item.tone}}">{{item.symbol}}</view><view class="app-label">{{item.label}}</view></view></view>
  </view>
  <view class="notice-card" bindtap="openDelivery" hover-class="tap-muted"><view class="notice-badge">公告</view><view class="notice-text">{{latestUpdate ? '工程进度：' + latestUpdate.title : '社区信息请真实发布，商家服务请核验资质与合同'}}</view><view class="notice-arrow">›</view></view>
  <view class="home-section recommendation-section">
    <view class="section-heading"><view><view class="section-title">社区推荐</view><view class="section-caption">服务信息与商业合作均明确标识</view></view></view>
    <swiper class="ad-swiper" autoplay circular interval="4200" duration="240" indicator-dots bindchange="onAdChange"><swiper-item wx:for="{{adBanners}}" wx:key="title" data-item="{{item}}" bindtap="onAdTap"><view class="ad-banner ad-{{item.tone}}"><view class="ad-label">{{item.label}}</view><view class="ad-title">{{item.title}}</view><view class="ad-desc">{{item.desc}}</view><view class="ad-action">查看详情 <text>›</text></view></view></swiper-item></swiper>
  </view>
</view>
