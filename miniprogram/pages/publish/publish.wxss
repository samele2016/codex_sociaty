.form {
  background: #ffffff;
  border: 1px solid #e5e8df;
  border-radius: 8px;
  padding: 20px;
}

.field {
  margin-bottom: 20px;
}

.label {
  margin-bottom: 8px;
  color: #374151;
  font-size: 16px;
  font-weight: 600;
}

input,
textarea,
.picker {
  width: 100%;
  padding: 12px;
  border: 1px solid #dfe4d8;
  border-radius: 8px;
  background: #fbfcf8;
  box-sizing: border-box;
  font-size: 16px;
}

textarea {
  height: 128px;
}

.image-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.image-wrap {
  position: relative;
}

.image-wrap image,
.add-image {
  width: 100%;
  height: 112px;
  border-radius: 8px;
  background: #eef4e9;
}

.add-image {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #276749;
  font-size: 34px;
}

.remove {
  position: absolute;
  top: 6px;
  right: 6px;
  width: 44px;
  height: 44px;
  line-height: 44px;
  text-align: center;
  border-radius: 22px;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.55);
}

.submit {
  margin-top: 8px;
}
