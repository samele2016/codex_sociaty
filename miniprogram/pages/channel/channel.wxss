.channel-page { padding-bottom: calc(88px + env(safe-area-inset-bottom)); }
.channel-topbar { display: flex; align-items: center; gap: 6px; min-height: 48px; padding: 0 4px; margin-bottom: 8px; color: #1769e0; font-size: 15px; }
.back-arrow { width: 28px; font-size: 28px; line-height: 1; text-align: center; }
.channel-header { margin-bottom: 16px; padding: 20px; border: 1px solid #dbeafe; border-radius: 8px; background: #f7fbff; }
.channel-publish { width: 100%; margin-top: 16px; }
.channel-list { display: flex; flex-direction: column; gap: 12px; }
.post-card { padding: 18px; border: 1px solid #e3ebf6; border-radius: 8px; background: #fff; }
.post-card:active { opacity: .72; }
.post-card-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
.post-labels { display: flex; align-items: center; gap: 8px; }
.post-category { color: #1769e0; font-size: 13px; font-weight: 700; }
.commercial-tag { padding: 3px 6px; border-radius: 4px; background: #fff0f0; color: #b42318; font-size: 12px; font-weight: 700; }
.post-title { color: #10233f; font-size: 18px; font-weight: 750; line-height: 1.4; }
.post-content { display: -webkit-box; margin-top: 6px; overflow: hidden; color: #475569; font-size: 15px; line-height: 1.55; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
.post-cover { width: 100%; height: 184px; margin-top: 12px; border-radius: 6px; background: #eef2f7; }
.post-meta { margin-top: 12px; color: #94a3b8; font-size: 13px; }
.channel-empty { border: 1px solid #e3ebf6; border-radius: 8px; background: #fff; }
.empty-desc { margin-top: 8px; color: #94a3b8; font-size: 15px; }
.empty-button { margin-top: 18px; }
.loading-text { padding: 24px; color: #7a8496; font-size: 14px; text-align: center; }
@media (min-width: 1200px) { .channel-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); } .channel-header { padding: 24px; } }
