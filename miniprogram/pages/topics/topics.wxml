<view class="page page-narrow topics-page">
  <view class="page-header">
    <view>
      <view class="eyebrow">业主共议</view>
      <view class="title title-lg">问题投票</view>
      <view class="muted">集中收集交付、装修和社区服务问题。投票反映关注度，不替代物业、开发商或主管部门的正式答复。</view>
    </view>
  </view>
  <button wx:if="{{canParticipate}}" class="button-primary" bindtap="openComposer">发起一个问题</button>
  <view wx:elif="{{!loading}}" class="helper">业主认证后可发起问题和参与投票。</view>
  <view wx:if="{{loading}}" class="empty">正在加载问题...</view>
  <view wx:elif="{{topics.length === 0}}" class="empty">还没有公开问题，欢迎发起第一个议题。</view>
  <view wx:for="{{topics}}" wx:key="_id" class="section topic-card">
    <view class="topic-top">
      <text class="tag">{{item.category === 'delivery' ? '交付与工程' : item.category === 'renovation' ? '装修准备' : '社区服务'}}</text>
      <text class="muted">{{item.authorName}}</text>
    </view>
    <view class="topic-title">{{item.title}}</view>
    <view class="topic-content">{{item.content}}</view>
    <button wx:if="{{canParticipate}}" size="mini" class="vote-button {{item.voted ? 'voted' : ''}}" data-id="{{item._id}}" bindtap="vote">{{item.voted ? '已投票' : '支持这个问题'}} {{item.voteCount || 0}}</button>
  </view>
  <view wx:if="{{composing}}" class="composer-mask">
    <view class="composer">
      <view class="title title-sm">发起问题</view>
      <view class="field"><view class="label">问题标题</view><input maxlength="80" placeholder="一句话说明你希望被关注的问题" value="{{title}}" data-key="title" bindinput="onInput" /></view>
      <view class="field"><view class="label">问题分类</view><picker mode="selector" range="{{categories}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryChange"><view class="picker">{{categories[categoryIndex].label}}</view></picker></view>
      <view class="field"><view class="label">补充说明</view><textarea maxlength="800" placeholder="说明位置、现象和希望了解的内容。请勿公开个人联系方式。" value="{{content}}" data-key="content" bindinput="onInput"></textarea></view>
      <view class="composer-actions"><button class="button-secondary" bindtap="closeComposer">取消</button><button class="button-primary" loading="{{submitting}}" bindtap="submit">发布问题</button></view>
    </view>
  </view>
</view>
