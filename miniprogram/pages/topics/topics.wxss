.topics-page { padding-bottom: calc(72rpx + env(safe-area-inset-bottom)); }
.topic-card { padding-bottom: 24rpx; }
.topic-top { display: flex; justify-content: space-between; gap: 20rpx; }
.topic-title { margin-top: 16rpx; color: #10233f; font-size: 30rpx; font-weight: 750; line-height: 1.4; }
.topic-content { margin-top: 10rpx; color: #475569; font-size: 26rpx; line-height: 1.6; white-space: pre-wrap; }
.vote-button { width: auto; min-width: 190rpx; margin-top: 20rpx; color: #1e40af; background: #eef6ff; border: 1rpx solid #bfdbfe; }
.vote-button.voted { color: #ffffff; background: #2563eb; }
.composer-mask { position: fixed; z-index: 20; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; padding: 24rpx; background: rgba(15, 23, 42, .45); }
.composer { width: 100%; max-height: 88vh; overflow-y: auto; padding: 28rpx; border-radius: 20rpx; background: #ffffff; }
.composer-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.composer-actions .button-secondary, .composer-actions .button-primary { min-width: 0; }
