.inspection-page { padding-bottom: calc(72rpx + env(safe-area-inset-bottom)); }
.progress-card { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-bottom: 20rpx; padding: 24rpx; border-radius: 16rpx; background: #eaf3ff; border: 1rpx solid #bfdbfe; }
.progress-value { color: #1e40af; font-size: 44rpx; font-weight: 800; line-height: 1; }
.progress-track { flex: 1; height: 16rpx; overflow: hidden; border-radius: 99rpx; background: #dbeafe; }
.progress-fill { height: 100%; border-radius: inherit; background: #2563eb; transition: width .2s ease; }
.checklist-group { padding-top: 22rpx; padding-bottom: 8rpx; }
.check-row { display: flex; align-items: flex-start; min-height: 44px; gap: 18rpx; padding: 20rpx 0; border-top: 1rpx solid #e9eff8; }
.check-box { flex: 0 0 auto; width: 34rpx; height: 34rpx; margin-top: 2rpx; border: 2rpx solid #94a3b8; border-radius: 8rpx; }
.check-box.checked { border-color: #2563eb; background: #2563eb; box-shadow: inset 0 0 0 7rpx #ffffff; }
.check-label { color: #24364f; font-size: 27rpx; line-height: 1.55; }
.reset-button { margin-top: 8rpx; }
