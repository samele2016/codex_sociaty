.custom-nav {
  background: #ffffff;
  border-bottom: 1px solid #e8eef6;
}

.custom-nav-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
}

.custom-nav-back {
  position: absolute;
  left: 8px;
  top: 50%;
  width: 44px;
  height: 44px;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: flex-start;
  color: #10233f;
}

.custom-nav-back text {
  font-size: 28px;
  font-weight: 300;
  line-height: 1;
}

.custom-nav-title {
  color: #10233f;
  font-size: 16px;
  font-weight: 600;
}

.verify-page {
  padding-top: 18px;
}

.form {
  background: #ffffff;
  border: 1px solid #e5e8df;
  border-radius: 8px;
  padding: 20px;
}

.field {
  margin-bottom: 20px;
}

.label {
  margin-bottom: 8px;
  font-weight: 600;
  font-size: 16px;
  line-height: 1.3;
}

input {
  width: 100%;
  height: 48px;
  padding: 0 12px;
  border: 1px solid #dfe4d8;
  border-radius: 8px;
  background: #fbfcf8;
  box-sizing: border-box;
  color: #10233f;
  font-size: 16px;
}

.privacy-consent {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 44px;
  margin: 2px 0 18px;
  color: #475569;
  font-size: 14px;
  line-height: 1.45;
}

.privacy-check {
  display: flex;
  align-items: center;
  min-width: 0;
}

.privacy-link {
  flex: 0 0 auto;
  color: #1e40af;
  font-weight: 600;
}

.button-primary {
  margin-top: 8px;
}
