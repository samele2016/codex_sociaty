.merchant-leads-page { padding-bottom: calc(72rpx + env(safe-area-inset-bottom)); }
.lead-card { padding-bottom: 28rpx; }
.lead-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.lead-demand { margin-top: 14rpx; color: #334155; font-size: 27rpx; line-height: 1.62; white-space: pre-wrap; }
.contact-box { margin-top: 18rpx; padding: 16rpx 18rpx; border: 1rpx solid #bbf7d0; border-radius: 12rpx; background: #f0fdf4; color: #166534; font-size: 26rpx; line-height: 1.5; word-break: break-all; }
.consent-note { margin-top: 18rpx; padding: 16rpx 18rpx; border-radius: 12rpx; background: #fff7ed; color: #9a3412; font-size: 25rpx; line-height: 1.5; }
.lead-actions { margin-top: 20rpx; }
