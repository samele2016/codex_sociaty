.profile {
  display: flex;
  align-items: center;
  gap: 14px;
}

.avatar {
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background: #eef4e9;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #276749;
  font-weight: 700;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  min-height: 52px;
  align-items: center;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid #eef0ea;
  font-size: 16px;
}

.menu-item:last-child {
  border-bottom: 0;
}

.small {
  font-size: 18px;
  margin-bottom: 12px;
}

.rule {
  margin-bottom: 10px;
  color: #4b5548;
  font-size: 15px;
  line-height: 1.5;
}
