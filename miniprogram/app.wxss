page {
  min-height: 100%;
  background: #f3f7fd;
  color: #10233f;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 16px;
}

view,
text,
input,
textarea,
button,
picker,
image {
  box-sizing: border-box;
}

.page {
  width: 100%;
  min-height: 100vh;
  max-width: 1120px;
  margin: 0 auto;
  padding: 16px 16px calc(32px + env(safe-area-inset-bottom));
}

.page-narrow {
  max-width: 680px;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 20px;
  margin-bottom: 16px;
  border-radius: 8px;
  background: #f7fbff;
  border: 1px solid #dbeafe;
}

.eyebrow {
  margin-bottom: 6px;
  color: #16a34a;
  font-size: 14px;
  font-weight: 700;
}

.section {
  background: #ffffff;
  border: 1px solid #e3ebf6;
  border-radius: 8px;
  padding: 18px;
  margin-bottom: 16px;
}

.title {
  color: #10233f;
  font-size: 20px;
  font-weight: 750;
  line-height: 1.28;
}

.title-lg {
  font-size: 26px;
  line-height: 1.18;
}

.title-sm,
.small {
  font-size: 18px;
  margin-bottom: 10px;
}

.muted {
  color: #64748b;
  font-size: 15px;
  line-height: 1.6;
}

.button-primary,
.button-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0 18px;
  border-radius: 8px;
  font-size: 16px;
  line-height: 1.35;
  text-align: center;
  white-space: normal;
  word-break: break-word;
  font-weight: 700;
}

button {
  min-height: 44px;
  padding: 0 16px;
  border-radius: 8px;
  font-size: 15px;
  line-height: 44px;
}

.button-primary {
  background: #1e40af;
  color: #ffffff;
  border: 0;
}

button[size="mini"] {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 72px;
  min-height: 44px;
  padding: 0 12px;
  border-radius: 8px;
  font-size: 14px;
  line-height: 44px;
  white-space: nowrap;
}

.button-secondary {
  background: #eef6ff;
  color: #1e40af;
  border: 1px solid #bfdbfe;
}

button::after {
  border: 0;
}

.button-primary,
.button-secondary {
  width: 100%;
  min-width: 0;
}

.button-primary {
  font-size: 16px;
}

.helper {
  margin-top: 8px;
  color: #64748b;
  font-size: 15px;
  line-height: 1.6;
}

button:active,
.menu-item:active,
.app-item:active,
.app-card:active,
.activity-card:active {
  opacity: .72;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 26px;
  padding: 0 10px;
  border-radius: 999px;
  background: #eef6ff;
  color: #1e40af;
  font-size: 13px;
  font-weight: 700;
}

.tag-warm {
  background: #fff7ed;
  color: #c2410c;
}

.status-warn {
  color: #c2410c;
}

.status-danger {
  color: #dc2626;
}

.empty {
  padding: 56px 16px;
  text-align: center;
  color: #64748b;
  font-size: 16px;
}

input,
textarea,
.picker {
  width: 100%;
  border: 1px solid #d9e4f2;
  border-radius: 8px;
  background: #f8fbff;
  color: #10233f;
  font-size: 16px;
}

input,
.picker {
  min-height: 48px;
  padding: 0 12px;
}

textarea {
  min-height: 128px;
  padding: 12px;
  line-height: 1.58;
}

@media (min-width: 900px) {
  .page {
    padding: 28px 32px calc(40px + env(safe-area-inset-bottom));
  }

  .page-narrow {
    max-width: 720px;
  }

  .section {
    padding: 24px;
  }
}
